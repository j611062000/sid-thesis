---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---

<Base
  title="Subscribe"
  description="Follow Sid Thesis through RSS. Email subscription availability and updates for independent research on technology, business, and capital."
>
  <div class="wrap">
    <header class="page-heading">
      <p class="eyebrow">Stay curious</p>
      <h1>
        Keep the research
        <br />
        <em>within reach.</em>
      </h1>
      <p>
        A way to follow the questions, and the research that grows from them.
      </p>
    </header>
    <div class="channel-grid">
      <section class="channel-card">
        <span class="eyebrow">01 / Email</span>
        <h2>
          {site.newsletterUrl
            ? 'Research in your inbox.'
            : 'A newsletter, in time.'}
        </h2>
        <p>
          {site.newsletterUrl
            ? 'Subscribe through the newsletter provider to receive new research by email.'
            : 'Email subscriptions are not open yet. Once the newsletter is ready, you’ll be able to subscribe here.'}
        </p>
        {site.newsletterUrl ? (
          <a class="button" href={site.newsletterUrl}>
            Subscribe by email ↗
          </a>
        ) : (
          <span class="status">Coming later</span>
        )}
      </section>
      <section class="channel-card">
        <span class="eyebrow">02 / RSS</span>
        <h2>Your reader. Your pace.</h2>
        <p>
          Add Sid Thesis to your preferred feed reader. New published articles
          will appear automatically. The feed is ready; it will be empty until
          the first article is published.
        </p>
        <a class="text-link" href="/rss.xml">
          Open the RSS feed ↗
        </a>
        <p class="feed-url">
          Feed address <code>https://sidthesis.com/rss.xml</code>
        </p>
      </section>
    </div>
    <div class="quiet-note">
      <p>No email addresses are collected on this site.</p>
      <a class="small-link" href="/research/">
        Explore upcoming research ↗
      </a>
    </div>
  </div>
</Base>
